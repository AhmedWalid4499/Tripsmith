# ─── Core ──────────────────────────────────────────────────────────────
# Postgres connection string. Railway provides this as ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://tripsmith:tripsmith@localhost:5432/tripsmith?schema=public"
# Public base URL of the app (used for metadata, OG images, share links).
APP_URL="http://localhost:3000"

# ─── Auth.js ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Must match APP_URL in production.
AUTH_URL="http://localhost:3000"
# Google sign-in (optional). The button only shows when both are set.
# Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend API key for magic-link emails. Leave empty in dev: links are printed to the server console.
AUTH_RESEND_KEY=""
# Sender for magic-link emails (must be a verified Resend domain in production).
EMAIL_FROM="Tripsmith <no-reply@example.com>"

# ─── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# "live" calls the API; "mock" uses recorded fixtures (tests, local dev without a key).
LLM_MODE="live"

# ─── Data providers ────────────────────────────────────────────────────
# "mock" (sample data) or "llm" (model estimates). Real APIs plug in later behind these flags.
FLIGHT_PROVIDER="mock"
HOTEL_PROVIDER="mock"
ACTIVITY_PROVIDER="mock"
VISA_PROVIDER="mock"
WEATHER_PROVIDER="mock"
FX_PROVIDER="mock"

# ─── Jobs ──────────────────────────────────────────────────────────────
# "true" runs the generation worker inside the web process (handy locally).
# In production run the separate worker service and keep this "false".
RUN_WORKER_IN_WEB="false"

# ─── Limits ────────────────────────────────────────────────────────────
GENERATIONS_PER_DAY_USER="10"
GENERATIONS_PER_DAY_IP="5"
GUEST_TRIP_TTL_DAYS="7"
